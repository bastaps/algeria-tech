/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'unsafe-inline' 'unsafe-eval' https://*.onrender.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://www.youtube.com https://s.ytimg.com; connect-src 'self' https://cloudflareinsights.com https://img.youtube.com https://*.onrender.com https://api.open-meteo.com https://open.er-api.com https://*.cloudflare.com https://www.googleapis.com https://translate.googleapis.com https://api.mymemory.translated.net https://api.rss2json.com https://rss.app https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; object-src 'self' blob:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' blob: https://*.youtube.com https://bastaps.github.io; frame-ancestors 'self';
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(self), geolocation=(self), payment=(), usb=()

# ── HTML : toujours frais ──────────────────────────────────────────────────────
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# ── Service Worker : pas de cache (doit être rechargé à chaque visite) ─────────
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# ── Données JSON : revalidation toutes les 5 min ──────────────────────────────
/articles.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/veille_data.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/tic_social.json
  Cache-Control: no-cache, must-revalidate

/revue_presse.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/barometre_data.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/barometre_history.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/barometre_weekly.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/barometre_weekly_history.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/joradp_static.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/arpce_static.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ── Assets statiques : toujours revalidés (ETag → 304 si inchangé, ~5ms) ───────
# max-age=0 supprimé : avec Cache First SW + max-age=86400, le contenu périmait 24h.
# Network First SW + no-cache = le navigateur valide avec le serveur à chaque visite.
/style.css
  Cache-Control: no-cache, must-revalidate

/script.js
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400

# ── Images : cache 7 jours ─────────────────────────────────────────────────────
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# ── Polices / bibliothèques locales (versionnées dans le chemin) : cache 1 an ─────
/libs/*
  Cache-Control: public, max-age=31536000, immutable

# ── Vidéos (flash, articles) : cache 7 jours ──────────────────────────────────
/videos/*
  Cache-Control: public, max-age=604800

/infographies/*
  Cache-Control: public, max-age=604800

# ── Flux RSS et sitemap Google News ─────────────────────────────────────
/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=600

/news-sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=600
